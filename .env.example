# Copy to .env to override compose defaults (optional for local dev).
# cp .env.example .env

# ---- Postgres ----
POSTGRES_USER=inbox
POSTGRES_PASSWORD=inbox
POSTGRES_DB=shared_inbox
POSTGRES_PORT=5432

# ---- Ports ----
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ---- Backend ----
ENVIRONMENT=development
DEBUG=true
# Generate one and set it: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-long-random-string
PUBLIC_BASE_URL=http://localhost:8000

# ---- Viber (leave empty for offline dev) ----
VIBER_AUTH_TOKEN=
VIBER_API_BASE_URL=https://chatapi.viber.com/pa
VIBER_WEBHOOK_URL=
VIBER_SENDER_NAME=Support Bot
VIBER_AUTO_REPLY=Hi! An agent will reply shortly.

# ---- Telegram (leave empty to disable) ----
TELEGRAM_BOT_TOKEN=
# Random string; generate with: python -c "import secrets; print(secrets.token_hex(24))"
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_AUTO_REPLY=Hi! An agent will reply shortly.

# ---- Voice / video calls (Jitsi Meet) ----
JITSI_DOMAIN=meet.jit.si
# {kind} = voice/video, {url} = join link. Empty = built-in English text.
CALL_INVITE_TEMPLATE=

# ---- Frontend (baked at build time) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
NEXT_PUBLIC_APP_NAME=Shared Inbox
