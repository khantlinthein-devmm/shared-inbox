# ---- PRODUCTION - copy to .env on the server, do NOT commit secrets ----
# Usage on server:
#   Copy-Item .env.production .env   # Windows
#   # cp .env.production .env        # Linux
# Then fill every CHANGE-ME value.

# ---- App ----
APP_NAME=Shared Inbox
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=XvbhJn4yG7zFnKEnHvAfyVljpr1wOl0VYKvvsPzZd12ZZaoE3oQ10um_sPM4DxwQPPqqHmAQ6ZOD5C_r2XCX8Q
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql+asyncpg://inbox:CHANGE-ME-DB-PASSWORD@your-db-host:5432/shared_inbox

# ---- CORS (production frontend only) ----
CORS_ORIGINS=["https://your-frontend"]

# ---- Uploads ----
UPLOAD_DIR=uploads
# Must be public for Viber attachment fetching.
PUBLIC_BASE_URL=https://your-backend-public

# ---- First admin (bootstrap, NOT seeded) ----
# Tables are created with `python init_db.py`, then create the owner account with:
#   python create_admin.py --email you@company.com
# Never commit passwords. Admins manage agents via /admin/users.

# ---- Viber Bot API ----
VIBER_AUTH_TOKEN=CHANGE-ME-VIBER-AUTH-TOKEN
VIBER_API_BASE_URL=https://chatapi.viber.com/pa
VIBER_WEBHOOK_URL=https://your-backend-public/api/v1/viber/webhook
VIBER_WEBHOOK_EVENTS=["conversation_started","subscribed","unsubscribed","message","delivered","seen"]
VIBER_SENDER_NAME=Support Bot
VIBER_AUTO_REPLY=Hi! An agent will reply shortly.
