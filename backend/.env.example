# ---- App ----
APP_NAME=Shared Inbox
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql+asyncpg://inbox:inbox@localhost:5432/shared_inbox

# ---- CORS (comma/JSON list of allowed origins) ----
CORS_ORIGINS=["http://localhost:3000"]

# ---- Uploads ----
# Local directory that stores agent attachments (served under /uploads).
UPLOAD_DIR=uploads
# Public base URL the /uploads files are reachable at. Telegram uploads files directly, but Viber downloads them from this URL,
# so set it to your public/ngrok address when using Viber attachments.
PUBLIC_BASE_URL=http://localhost:8000

# ---- First admin (bootstrap, NOT seeded) ----
# No default users are created by init_db.py.
# Create the first admin with:  python create_admin.py --email you@company.com
# Admins then create/disable agents via the dashboard (/admin/users)
# or POST /api/v1/users.

# ---- Viber Bot API ----
VIBER_AUTH_TOKEN=
# Override the Viber API host (e.g. VIBER_API_BASE_URL=http://localhost:9000/pa for a mock).
VIBER_API_BASE_URL=https://chatapi.viber.com/pa
VIBER_WEBHOOK_URL=https://your-public-host/api/v1/viber/webhook
VIBER_WEBHOOK_EVENTS=["conversation_started","subscribed","unsubscribed","message","delivered","seen"]
VIBER_SENDER_NAME=Support Bot
# Optional auto reply sent when a contact writes. Leave empty to disable.
VIBER_AUTO_REPLY=Hi! An agent will reply shortly.

# ---- Telegram Bot API ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_WEBHOOK_URL=https://your-public-host/api/v1/telegram/webhook
# Random secret Telegram echoes back on every webhook call (set via /diagnostics/telegram/set-webhook).
TELEGRAM_WEBHOOK_SECRET=
# Optional auto reply sent when a contact writes. Leave empty to disable.
TELEGRAM_AUTO_REPLY=Hi! An agent will reply shortly.